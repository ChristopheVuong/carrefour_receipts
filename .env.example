# Copy to `.env` and adjust. `.env` is git-ignored — never commit real secrets.
# Loaded automatically by carrefour_receipts_api.config (python-dotenv).
# For CLI tooling you can also run:  uv run --env-file .env <command>

# --- Filesystem / extraction ---
DATA_DIRECTORY=data
COOKIES_FILE=data/cookies.txt
SECRETS_FILE=data/secrets.yml

# --- Loyalty / fidélité card numbers (PII — query params for the receipt/loyalty endpoints) ---
# Optional here: the auth service scrapes/saves them to SECRETS_FILE. If set, .env wins.
LOYALTY_CARD_NUMBER=
PASS_CARD_NUMBER=

# --- Carrefour auth portal (FastAPI auth service: browser login -> cookies) ---
CARREFOUR_LOGIN_URL=https://www.carrefour.fr/login
CARREFOUR_ACCOUNT_URL=https://www.carrefour.fr/mon-compte
# Authenticated JSON endpoint the auth service reads for the loyalty / Pass card numbers.
CARREFOUR_CARDS_URL=https://www.carrefour.fr/api/user/secured/loyalty/my-cards
# Persistent browser profile reused by the Playwright login (helps pass Cloudflare
# Turnstile by looking like a returning user). Git-ignored under data/.
BROWSER_PROFILE_DIR=data/browser_profile
# Real browser to drive. Empty = auto (Chrome -> Edge -> Chromium). Force one with a
# Playwright channel, e.g. "chrome" or "msedge".
BROWSER_CHANNEL=
# TLS fingerprint the extractor's HTTP client (curl_cffi) impersonates to reach the API
# past Cloudflare. Must match the login browser family (Edge by default). curl_cffi values:
# edge101, chrome120, chrome131, safari180, ...
CARREFOUR_TLS_IMPERSONATE=edge101

# --- Modern data stack (dlt -> DuckDB -> dbt) ---
# DUCKDB_PATH is also read by the dbt profile (transform/profiles.yml).
DUCKDB_PATH=carrefour.duckdb
DUCKDB_DATASET=raw
# Both read JSON. For your real extracts, point both at `data` (receipts and
# loyalty JSON co-locate under data/{YYYYMMDD}/); the recursive globs pick the
# right docs (receipts have `id`, loyalty months have a `history` array).
RECEIPTS_SOURCE_DIR=tests/fixtures/receipts
LOYALTY_SOURCE_DIR=tests/fixtures/loyalty
ORDERS_SOURCE_DIR=tests/fixtures/orders
# Min similarity (0..1) for product categorization (int_product_categorized);
# below it a label falls back to the VAT-based category.
CATEGORY_MATCH_THRESHOLD=0.80
# Opt in to the fastembed (ONNX) semantic categorizer instead of rapidfuzz.
# Off by default; requires the `ml` extra. Local exploration only.
CATEGORY_USE_EMBEDDINGS=false

# --- Financial assistant (Vanna 2.0 text-to-SQL, dashboard "Assistant" page) ---
# LLM via an OpenAI-compatible endpoint. Two supported providers:
#   OpenAI:  ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1  + a real key + e.g. gpt-4o-mini
#   Ollama:  ASSISTANT_LLM_BASE_URL=http://localhost:11434/v1  + any dummy key + e.g. qwen2.5-coder
ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
ASSISTANT_LLM_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
# Optional local vector store for learned examples (git-ignored under data/).
ASSISTANT_VECTOR_DIR=data/vanna_chroma

# --- Logging ---
# LOG_LEVEL: DEBUG/INFO/WARNING/ERROR. LOG_JSON=true for line-delimited JSON logs.
LOG_LEVEL=INFO
LOG_JSON=false
